# ==========================================
# CONVEE - GitHub Repository .gitignore
# ==========================================

# --- Environment & Credentials (Security) ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env*
*.key
*.pem
.credentials
credentials.json
*token.json*
*key*.json
*serviceaccount*.json
*service-account*.json

# Allow tracked template examples
!.env.example
!**/.env.example

# --- Dependencies & Package Managers ---
node_modules/
**/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python Virtual Environments
venv/
.venv/
env/
.env/
*.egg-info/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# --- Production & Build Outputs ---
/build
**/build/
dist/
**/dist/
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Prisma Client Generated Artifacts & Query Engines
backend/src/generated/
**/src/generated/
*.node
*.tmp*
query_engine*

# --- Uploads & File Storage ---
uploads/
**/uploads/*
!**/uploads/.gitkeep

# --- Logs, Caches & System Files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
.cache/
**/.cache/
.temp/
temp/
.DS_Store
Thumbs.db

# --- Databases ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
.emergent/
.gitconfig

# --- Testing, Reports & Temporary Output ---
/coverage
**/coverage/
tests/
**/tests/
tests/artifacts/
test_reports/
test_result.md
test-results/
**/test-results/
playwright-report/
scraped_output.json
*.scraped_output.json
agent_artifacts/
.agent_artifacts/
.screenshots/
DUMMY_DATA.txt
mock_students.csv
*.xml
*.png
*.jpg
*.jpeg
*.docx

# Test Files & Suites
*.test.js
*.test.ts
*.test.jsx
*.test.tsx
*.spec.js
*.spec.ts
*.spec.jsx
*.spec.tsx

# Security Audits & Diagnostic Reports
security_audit_results/
security_audit_result/
*security_audit*
**/security_audit_results/**
**/security_audit_result/**

# Whitelist UI Assets and Android Native Configs
!frontend/public/**
!frontend/src/assets/**
!mobile/assets/**
!mobile-react/assets/**
!mobile-flutter/assets/**
!mobile-react/android/**
!mobile-flutter/android/**
!**/AndroidManifest.xml
!**/res/**

# Scratch, Test & Seed Scripts
backend/scripts/*.ts
backend/scripts/
backend/src/scripts/
frontend/scripts/

